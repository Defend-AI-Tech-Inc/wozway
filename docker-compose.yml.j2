# Enhanced docker-compose with AI detection and dashboard
version: '3.8'

services:
  # OpenWebUI - Chat interface
  owebui:
    image: ghcr.io/open-webui/open-webui:latest
    container_name: owebui
    hostname: owebui
    volumes:
      - ./openwebui:/app/backend/data
    depends_on:
      - wauzeway
    ports:
      - 8084:3082
    environment:
      - PORT=3082
      - WEBUI_AUTH=False
      - ENABLE_SIGNUP=False
      - OPENAI_API_KEYS={{ llm_api_key }}
      - OPENAI_API_BASE_URLS=http://wauzeway:9080/openai/v1
      - DEFAULT_MODELS=llama-3.1-8b-instant
    extra_hosts:
      - host.docker.internal:host-gateway
    restart: unless-stopped

  # APISIX Gateway with policy enforcement
  wauzeway:
    image: public.ecr.aws/u1j5h7e7/aigateway:wauzeway.0.01-2
    container_name: wauzeway
    hostname: wauzeway
    depends_on:
      - etcd
    restart: always
    volumes:
      - ./apisix/config.yaml:/usr/local/apisix/conf/config.yaml:ro
      - ./apisix/local_policy.lua:/opt/apisix/plugins/local_policy.lua:ro
      - ./apisix/semantic_policy.lua:/opt/apisix/plugins/semantic_policy.lua:ro
      - ./apisix/wauzeway_proxy.lua:/opt/apisix/plugins/wauzeway_proxy.lua:ro
    ports:
      - "9180:9180/tcp"
      - "9080:9080/tcp"
      - "9091:9091/tcp"
      - "9443:9443/tcp"
      - "9092:9092/tcp"
    environment:
      - APISIX_LISTEN_ADDRESS=unix:/tmp/runner.sock
      - APISIX_UPSTREAM_URI=/wauzeway
      - DEFENDAI_TENANT_ID={{ tenant_name }}
      - DEFENDAI_API_KEY={{ tenant_api_key }}
      - LLM_PROVIDER={{ llm_provider }}
      - LLM_API_KEY={{ llm_api_key }}

  # etcd - Configuration storage
  etcd:
    image: bitnami/etcd:3.5.11
    container_name: etcd
    hostname: etcd
    restart: always
    volumes:
      - ./etcd/data:/bitnami/etcd
    environment:
      ETCD_ENABLE_V2: "true"
      ALLOW_NONE_AUTHENTICATION: "yes"
      ETCD_ADVERTISE_CLIENT_URLS: "http://etcd:2379"
      ETCD_LISTEN_CLIENT_URLS: "http://0.0.0.0:2379"
    ports:
      - "2379:2379/tcp"

  # Admin service - Configure routes
  adminsvc:
    image: public.ecr.aws/u1j5h7e7/aigateway:adminsvc.0.01-2
    container_name: adminsvc
    hostname: adminsvc
    depends_on:
      - wauzeway
    volumes:
      - ./adminsvc/config_script_local.sh:/root/adminsvc/config_script.sh
    environment:
      - DEFENDAI_API_KEY={{ tenant_api_key }}
      - DEFENDAI_TENANT_ID={{ tenant_name }}
      - LLM_PROVIDER={{ llm_provider }}
      - LLM_API_KEY={{ llm_api_key }}
      - APISIX_API_KEY={{ apisix_admin_key }}
      - APISIX_GATEWAY=wauzeway
      - APISIX_UPSTREAM_URI=/wauzeway
    entrypoint:
      - /bin/bash
      - -c
      - "cd /root/adminsvc && chmod +x ./config_script.sh && ./config_script.sh"

  # NEW: AI Detection Service
  ai-detector:
    build:
      context: ./ai-detector
      dockerfile: Dockerfile
    container_name: ai-detector
    hostname: ai-detector
    depends_on:
      - ollama
    ports:
      - "8000:8000"
    environment:
      - OLLAMA_HOST=http://ollama:11434
    restart: unless-stopped

  # NEW: Ollama for local LLM inference
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    hostname: ollama
    ports:
      - "11434:11434"
    volumes:
      - ollama-data:/root/.ollama
    restart: unless-stopped
    # Pull model on startup
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        ollama serve &
        sleep 5
        ollama pull llama3.2:1b
        wait

  # NEW: Dashboard for policy management
  dashboard:
    build:
      context: ./dashboard
      dockerfile: Dockerfile
    container_name: wozway-dashboard
    hostname: dashboard
    depends_on:
      - wauzeway
    ports:
      - "8080:8080"
    environment:
      - APISIX_ADMIN_URL=http://wauzeway:9180
      - APISIX_API_KEY={{ apisix_admin_key }}
    restart: unless-stopped

volumes:
  ollama-data:
